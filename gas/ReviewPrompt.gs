  '- items の itemId は、渡された items の id をそのまま使う。コメントは、言うべきことがある項目だけ（多くても8件）。',
  '- overall（全体への感想）は3〜6文。praise（良いところ）は1〜3個。questions（本人への問いかけ）は1〜3個。'
].join('\n');

// 返事の形（structured outputs＝決まった形の JSON で返してもらう）
var ADVICE_SCHEMA = {
  type: 'object',
  additionalProperties: false,
  properties: {
    overall: { type: 'string' },
    praise: { type: 'array', items: { type: 'string' } },
    items: {
      type: 'array',
      items: {
        type: 'object',
        additionalProperties: false,
        properties: {
          itemId: { type: 'string' },
          comment: { type: 'string' },
          suggestion: { type: 'string' },
          rule: { type: 'string' }
        },
        required: ['itemId', 'comment', 'suggestion', 'rule']
      }
    },
    questions: { type: 'array', items: { type: 'string' } }
  },
  required: ['overall', 'praise', 'items', 'questions']
};

// レビューを頼む時のユーザー側の文（材料の JSON を包む）
function reviewUserText(packetText) {
  return '以下が、タイムバケットの今の中身です（アプリが作った材料。名前・生年月日・メモは含みません）。\n' +
    'この人にとって「普通のやりたいことリスト」にならず、本の考え方に沿った人生の置き方になっているか、見てください。\n\n' +
    '```json\n' + packetText + '\n```';
}
